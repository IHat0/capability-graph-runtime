# Variable names and safe placeholders only. Keep the real file outside Git.
PULSATE_ENVIRONMENT=production
PULSATE_SERVICE_IDENTITY=<service-identity>
PULSATE_APPLICATION_DATA_ROOT=/var/lib/pulsate
PULSATE_TRUSTED_CONFIGURATION_ROOT=/etc/pulsate
PULSATE_AUTH_ISSUER=<https-issuer>
PULSATE_AUTH_AUDIENCES=<audience>
PULSATE_AUTH_ALGORITHMS=RS256
PULSATE_AUTH_JWKS_FILE=<relative-jwks-file>
PULSATE_GRANT_DATABASE_FILE=security/grants.sqlite3
PULSATE_AUDIT_DATABASE_FILE=security/audit.sqlite3
PULSATE_CATALOGUE_ENABLED=<true-or-false>
PULSATE_CATALOGUE_REQUIRED=<true-or-false>
PULSATE_CATALOGUE_FILE=<relative-catalogue-file>
PULSATE_CATALOGUE_EXPECTED_IDENTIFIER=<catalogue-identifier>
PULSATE_CATALOGUE_EXPECTED_VERSION=<semantic-version>
PULSATE_CATALOGUE_EXPECTED_FINGERPRINT=<sha256>
PULSATE_CATALOGUE_MAXIMUM_BYTES=<bounded-integer>
PULSATE_CATALOGUE_MAXIMUM_ENTRIES=<bounded-integer>
PULSATE_CATALOGUE_ALLOW_EMPTY=<true-or-false>
